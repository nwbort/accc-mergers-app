<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Updates on followed mergers. Asked for the first time you follow one. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Which app is the browser, so links the app passes on reach one
         (and not back here). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".MergersApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Mergers">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The site's pages open here: the dashboard, the merger list, a merger,
                 the industries and an industry. Verified against
                 https://mergers.fyi/.well-known/assetlinks.json (the site's
                 frontend/public/.well-known/), which names the release key, so
                 they open without asking. www only redirects to the bare domain,
                 so it can't verify; claimed anyway so a phone that's told to can
                 open it. Anything else claimed here that the app has no screen
                 for (SiteLink) is handed back to the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="mergers.fyi" />
                <data android:host="www.mergers.fyi" />
                <data android:path="/" />
                <data android:path="/mergers" />
                <data android:pathPrefix="/mergers/" />
                <data android:pathPrefix="/industries" />
                <!-- A matter's documents live under its page's path
                     (/mergers/MN-01016/notice.pdf): those are the browser's. -->
                <uri-relative-filter-group android:allow="false">
                    <data android:pathAdvancedPattern=".*[.][pP][dD][fF]" />
                </uri-relative-filter-group>
            </intent-filter>
        </activity>

        <!-- Push: a message from mergers.fyi saying followed data changed. -->
        <service
            android:name=".notify.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- No token until Push.start asks for one: never in the tests, nor
             without a Firebase project configured. Nothing else of Firebase's
             is used, so nothing else of it collects anything. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
    </application>
</manifest>
